# Public domains. Amplify serves APP_DOMAIN; Caddy serves API_DOMAIN.
APP_DOMAIN=demo.example.com
API_DOMAIN=api.demo.example.com
CADDY_EMAIL=admin@example.com
CORS_ORIGIN=https://demo.example.com,https://www.demo.example.com
APP_BASE_URL=https://demo.example.com
NODE_ENV=production
DATABASE_URL=file:/app/data/studentcarr.db

# Generate separate, high-entropy values. Never commit deploy/.env.production.
JWT_ACCESS_SECRET=replace_with_a_long_random_value
JWT_REFRESH_SECRET=replace_with_a_long_random_value
# Must be exactly 64 hexadecimal characters; create it with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=replace_with_64_hex_characters
MCP_TOKEN_SECRET=replace_with_a_long_random_value

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_COOKIE_NAME=refresh_token

PROGRESS_TRACKING_SERVICE_BASE_URL=http://ai:10002
PROFILE_GENERATION_SERVICE_URL=http://ai:10002/generate-profile
MCP_SERVER_URL=http://mcp:10004
STUDENTCARR_API_URL=http://backend:10001

DOCUMENT_PARSER_CONCURRENCY=1
DOCUMENT_PARSER_MIN_CHARACTERS=200
DOCUMENT_PARSER_RENDER_SCALE=1.5

# Shared AI provider values. Leave blank only if every enabled AI feature uses
# an administrator-configured per-user LLM key instead.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_RETRIES=2
CHAT_MAX_STEPS=8
CHAT_TURN_TIMEOUT_MS=60000
MCP_TOOLS_TIMEOUT_MS=10000

# Optional vision/OCR endpoint used when a PDF has too little embedded text.
VLLM_BASE_URL=
VLLM_MODEL=
VLLM_API_KEY=
