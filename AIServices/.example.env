# Qwen (Alibaba Cloud DashScope) — OpenAI-compatible endpoint
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# Optional: override model id (e.g. qwen-turbo, qwen-max)
MODEL=qwen2.5-vl-72b-instruct
# Optional: use another OpenAI-compatible host (e.g. Ollama: http://localhost:11434/v1)
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# login https://smith.langchain.com/ to get the LANGSMITH_API_KEY use to debug AI workflow 
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=langgraph-email-demo
