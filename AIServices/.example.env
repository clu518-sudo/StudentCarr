# Qwen (Alibaba Cloud DashScope) — OpenAI-compatible endpoint
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# OpenAI key also supported and used by default when provided.
OPENAI_API_KEY=your_openai_api_key_here
# Optional: override model id (e.g. qwen-turbo, qwen-max)
MODEL=qwen2.5-vl-72b-instruct
OPENAI_TIMEOUT_MS=120000
OPENAI_MAX_RETRIES=2
# Limits to reduce timeout risk on large parsed documents.
PROFILE_DOCUMENT_MAX_CHARS=12000
PROFILE_CONTEXT_MAX_CHARS=40000
# Optional: use another OpenAI-compatible host (e.g. Ollama: http://localhost:11434/v1)
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Local AI services port (profile generation + progress tracking)
LANGGRAPH_PORT=10002

# login https://smith.langchain.com/ to get the LANGSMITH_API_KEY use to debug AI workflow 
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=langgraph-email-demo

GMAIL_SYNC_MAX_CANDIDATES=30
