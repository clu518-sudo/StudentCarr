// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ApiKey {
  id          String   @id @default(cuid())
  hashedKey   String   @unique
  label       String?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  lastUsedAt  DateTime?
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model UserLlmKey {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  label        String   @default("Untitled")
  provider     String   @default("openai")
  model        String?
  baseUrl      String?  @map("base_url")
  encryptedKey String   @map("encrypted_key")
  lastFour     String   @map("last_four")
  isSelected   Boolean  @default(false) @map("is_selected")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_llm_keys")
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  passwordHash    String        @map("password_hash")
  authProvider    String        @default("password") @map("auth_provider")
  googleSub       String?       @unique @map("google_sub")
  fullName        String?       @map("full_name")
  isEmailVerified Boolean       @default(false) @map("is_email_verified")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  sessions        AuthSession[]
  auditLogs       AuthAuditLog[]
  profile         UserProfile?
  profileDocuments ProfileDocument[]
  gmailAccount    GmailAccount?
  gmailOAuthStates GmailOAuthState[]
  progressApplications ProgressApplication[]
  progressEmails  ProgressEmail[]
  progressReplies ProgressEmailReply[]
  apiKey          ApiKey[]
  llmKeys         UserLlmKey[]

  @@map("users")
}

model AuthOAuthState {
  id        String   @id @default(uuid())
  stateHash String   @unique @map("state_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("auth_oauth_states")
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  deviceInfo       String?   @map("device_info")
  ipHash           String?   @map("ip_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuthAuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  eventType String   @map("event_type")
  metadata  String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@map("auth_audit_logs")
}

model UserProfile {
  id                 String           @id @default(uuid())
  userId             String           @unique @map("user_id")
  headline           String?
  summary            String?
  phone              String?
  location           String?
  preferredRoles     Json?            @map("preferred_roles")
  preferredLocations Json?            @map("preferred_locations")
  workAuthorization  String?          @map("work_authorization")
  salaryRange        String?          @map("salary_range")
  availability       String?
  links              Json?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  education          Education[]
  workExperiences    WorkExperience[]
  projects           Project[]
  certifications     Certification[]
  skills             Skill[]

  @@index([userId])
  @@map("user_profiles")
}

model Education {
  id            String      @id @default(uuid())
  userProfileId String      @map("user_profile_id")
  school        String
  degree        String?
  fieldOfStudy  String?     @map("field_of_study")
  startDate     String?     @map("start_date")
  endDate       String?     @map("end_date")
  grade         String?
  description   String?
  isCurrent     Boolean     @default(false) @map("is_current")
  sortOrder     Int         @default(0) @map("sort_order")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId])
  @@map("education")
}

model WorkExperience {
  id            String      @id @default(uuid())
  userProfileId String      @map("user_profile_id")
  company       String
  title         String
  location      String?
  startDate     String?     @map("start_date")
  endDate       String?     @map("end_date")
  isCurrent     Boolean     @default(false) @map("is_current")
  description   String?
  achievements  Json?
  sortOrder     Int         @default(0) @map("sort_order")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId])
  @@map("work_experiences")
}

model Project {
  id            String      @id @default(uuid())
  userProfileId String      @map("user_profile_id")
  name          String
  role          String?
  description   String?
  technologies  Json?
  startDate     String?     @map("start_date")
  endDate       String?     @map("end_date")
  projectUrl    String?     @map("project_url")
  repositoryUrl String?     @map("repository_url")
  sortOrder     Int         @default(0) @map("sort_order")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId])
  @@map("projects")
}

model Certification {
  id            String      @id @default(uuid())
  userProfileId String      @map("user_profile_id")
  name          String
  issuer        String?
  issueDate     String?     @map("issue_date")
  expiryDate    String?     @map("expiry_date")
  credentialId  String?     @map("credential_id")
  credentialUrl String?     @map("credential_url")
  sortOrder     Int         @default(0) @map("sort_order")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId])
  @@map("certifications")
}

model Skill {
  id                String      @id @default(uuid())
  userProfileId     String      @map("user_profile_id")
  name              String
  level             String?
  category          String?
  yearsOfExperience Int?        @map("years_of_experience")
  keywords          Json?
  sortOrder         Int         @default(0) @map("sort_order")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  userProfile       UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId])
  @@map("skills")
}

model ProfileDocument {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  documentType String   @map("document_type")
  originalName String   @map("original_name")
  storedName   String   @map("stored_name")
  mimeType     String   @map("mime_type")
  size         Int
  path         String
  status       String   @default("uploaded")
  parserStatus String   @default("pending") @map("parser_status")
  parsedText   String?  @map("parsed_text")
  extractionMethod String? @map("extraction_method")
  pageCount    Int?     @map("page_count")
  parserError  String?  @map("parser_error")
  parserStartedAt DateTime? @map("parser_started_at")
  parserCompletedAt DateTime? @map("parser_completed_at")
  parserUpdatedAt DateTime @default(now()) @updatedAt @map("parser_updated_at")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentType])
  @@index([parserStatus])
  @@map("profile_documents")
}

model GmailAccount {
  id                    String                @id @default(uuid())
  userId                String                @unique @map("user_id")
  googleSub             String                @unique @map("google_sub")
  googleEmail           String                @map("google_email")
  displayName           String?               @map("display_name")
  scope                 String?
  accessTokenEncrypted  String?               @map("access_token_encrypted")
  refreshTokenEncrypted String?               @map("refresh_token_encrypted")
  tokenType             String?               @map("token_type")
  expiresAt             DateTime?             @map("expires_at")
  connectedAt           DateTime              @default(now()) @map("connected_at")
  lastVerifiedAt        DateTime?             @map("last_verified_at")
  lastSyncedAt          DateTime?             @map("last_synced_at")
  isActive              Boolean               @default(true) @map("is_active")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncState             GmailSyncState?
  applications          ProgressApplication[]
  emails                ProgressEmail[]

  @@index([googleEmail])
  @@map("gmail_accounts")
}

model GmailOAuthState {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  stateHash String   @unique @map("state_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("gmail_oauth_states")
}

model GmailSyncState {
  id                    String       @id @default(uuid())
  gmailAccountId        String       @unique @map("gmail_account_id")
  lastSyncStatus        String       @default("idle") @map("last_sync_status")
  lastSyncStartedAt     DateTime?    @map("last_sync_started_at")
  lastSyncCompletedAt   DateTime?    @map("last_sync_completed_at")
  lastSyncError         String?      @map("last_sync_error")
  firstSyncCompletedAt  DateTime?    @map("first_sync_completed_at")
  lastHistoryId         String?      @map("last_history_id")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  gmailAccount          GmailAccount @relation(fields: [gmailAccountId], references: [id], onDelete: Cascade)

  @@map("gmail_sync_states")
}

model ProgressApplication {
  id                      String        @id @default(uuid())
  userId                  String        @map("user_id")
  gmailAccountId          String?       @map("gmail_account_id")
  companyName             String        @map("company_name")
  companyNameNormalized   String        @map("company_name_normalized")
  positionTitle           String        @map("position_title")
  positionTitleNormalized String        @map("position_title_normalized")
  contactEmail            String?       @map("contact_email")
  status                  String        @default("under_review")
  statusSourceEmailId     String?       @map("status_source_email_id")
  lastUpdatedAt           DateTime      @default(now()) @map("last_updated_at")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailAccount            GmailAccount? @relation(fields: [gmailAccountId], references: [id], onDelete: SetNull)
  emails                  ProgressEmail[]

  @@unique([userId, companyNameNormalized, positionTitleNormalized])
  @@index([userId, status])
  @@index([gmailAccountId])
  @@map("progress_applications")
}

model ProgressEmail {
  id              String                    @id @default(uuid())
  userId          String                    @map("user_id")
  gmailAccountId  String                    @map("gmail_account_id")
  applicationId   String?                   @map("application_id")
  gmailMessageId  String                    @map("gmail_message_id")
  gmailThreadId   String?                   @map("gmail_thread_id")
  gmailHistoryId  String?                   @map("gmail_history_id")
  rfcMessageId    String?                   @map("rfc_message_id")
  inReplyTo       String?                   @map("in_reply_to")
  referencesHeader Json?                    @map("references_header")
  parentEmailId   String?                   @map("parent_email_id")
  threadPosition  Int?                      @map("thread_position")
  subject         String
  sender          String
  senderEmail     String?                   @map("sender_email")
  recipients      Json?
  ccRecipients    Json?                     @map("cc_recipients")
  bccRecipients   Json?                     @map("bcc_recipients")
  snippet         String?
  labelIds        Json?                     @map("label_ids")
  rawHeaders      Json?                     @map("raw_headers")
  rawBodyText     String?                   @map("raw_body_text")
  rawBodyHtml     String?                   @map("raw_body_html")
  receivedAt      DateTime?                 @map("received_at")
  sentAt          DateTime?                 @map("sent_at")
  isUnread        Boolean                   @default(true) @map("is_unread")
  isRelevant      Boolean?                  @map("is_relevant")
  processingStage String                    @default("discovered") @map("processing_stage")
  aiProcessedAt   DateTime?                 @map("ai_processed_at")
  needsReplyDraft Boolean                   @default(false) @map("needs_reply_draft")
  replyRequiredAt DateTime?                 @map("reply_required_at")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailAccount    GmailAccount              @relation(fields: [gmailAccountId], references: [id], onDelete: Cascade)
  application     ProgressApplication?      @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  parentEmail     ProgressEmail?            @relation("ProgressEmailReplies", fields: [parentEmailId], references: [id], onDelete: SetNull)
  childReplies    ProgressEmail[]           @relation("ProgressEmailReplies")
  intelligence    ProgressEmailIntelligence?
  replies         ProgressEmailReply[]

  @@unique([gmailAccountId, gmailMessageId])
  @@index([userId, applicationId])
  @@index([gmailAccountId, receivedAt])
  @@index([gmailThreadId])
  @@index([rfcMessageId])
  @@index([parentEmailId])
  @@index([applicationId, parentEmailId])
  @@map("progress_emails")
}

model ProgressEmailIntelligence {
  id                         String        @id @default(uuid())
  emailId                    String        @unique @map("email_id")
  summary                    String?
  intent                     String        @default("unknown")
  companyName                String?       @map("company_name")
  positionTitle              String?       @map("position_title")
  contactEmail               String?       @map("contact_email")
  confidence                 Float?
  needsReplyDraft            Boolean       @default(false) @map("needs_reply_draft")
  suggestedApplicationStatus String?       @map("suggested_application_status")
  reviewNotes                String?       @map("review_notes")
  extractedAt                DateTime      @default(now()) @map("extracted_at")
  createdAt                  DateTime      @default(now()) @map("created_at")
  updatedAt                  DateTime      @updatedAt @map("updated_at")
  email                      ProgressEmail @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([intent])
  @@map("progress_email_intelligence")
}

model ProgressEmailReply {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  emailId       String        @map("email_id")
  status        String        @default("drafted")
  draftText     String        @map("draft_text")
  reviewedText  String?       @map("reviewed_text")
  sentMessageId String?       @map("sent_message_id")
  sentThreadId  String?       @map("sent_thread_id")
  errorMessage  String?       @map("error_message")
  confirmedAt   DateTime?     @map("confirmed_at")
  sentAt        DateTime?     @map("sent_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  email         ProgressEmail @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([emailId, createdAt])
  @@map("progress_email_replies")
}
